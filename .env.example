# SecretPixel Environment Configuration

# Disable Vite Hot Module Reloading when running in agent or production environments
DISABLE_HMR=true

# Python Backend API Port & URL (defaults to http://127.0.0.1:5000)
PYTHON_PORT=5000
VITE_API_BASE_URL=

# Note: SecretPixel operates completely in-memory without requiring any database.
# No Supabase or database keys are required.
